DJANGO_ENV=local
SECRET_KEY=your-secret-key-here
DEBUG=True

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
DB_ENGINE=django.db.backends.postgresql
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_BROKER_DB=2
REDIS_BEAT_DB=3

CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_WS_URL=ws://localhost:8001/connection/websocket
CENTRIFUGO_API_KEY=your-api-key
CENTRIFUGO_SECRET=your-secret
CENTRIFUGO_NAMESPACE=question
